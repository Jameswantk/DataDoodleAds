{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signalfound-audit-engine",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signalfound-audits",
      "database_id": "<provisioned-d1-database-id>",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "signalfound-audit-evidence"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "signalfound-audit-workflow",
      "binding": "AUDIT_WORKFLOW",
      "class_name": "AuditWorkflow"
    }
  ],
  "vars": {
    "AUDIT_CACHE_TTL_DAYS": "14",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "REPORT_CTA_LABEL": "Book a consultation"
  }
}
