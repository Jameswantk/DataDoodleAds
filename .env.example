# Required by the server-to-server intake API.
AUDIT_API_KEY=

# Optional completion callback to the marketer's backend or CRM adapter.
AUDIT_CALLBACK_URL=
AUDIT_CALLBACK_SIGNING_SECRET=

# Optional Cloudflare Workers AI narrative model. The deterministic score does
# not depend on this model and gracefully falls back to rules-only copy.
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Reuse an unchanged site's result for 1-30 days. Defaults to 14.
AUDIT_CACHE_TTL_DAYS=14

# Optional consultation CTA shown on completed reports.
REPORT_CTA_URL=
REPORT_CTA_LABEL=Book a consultation
